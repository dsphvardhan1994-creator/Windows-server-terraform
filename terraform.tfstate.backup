            "id": "arn:aws:iam::934685482624:policy/harsha-windows-fleet-manager-operator",
            "name": "harsha-windows-fleet-manager-operator",
            "name_prefix": "",
            "path": "/",
            "policy": "{\"Statement\":[{\"Action\":[\"ec2:DescribeInstances\",\"ec2:GetPasswordData\"],\"Effect\":\"Allow\",\"Resource\":\"*\"},{\"Action\":[\"ssm:DescribeInstanceProperties\",\"ssm:GetCommandInvocation\",\"ssm:GetInventorySchema\"],\"Effect\":\"Allow\",\"Resource\":\"*\"},{\"Action\":[\"ssm-guiconnect:CancelConnection\",\"ssm-guiconnect:GetConnection\",\"ssm-guiconnect:StartConnection\",\"ssm-guiconnect:ListConnections\"],\"Effect\":\"Allow\",\"Resource\":\"*\"},{\"Action\":[\"ssm:StartSession\"],\"Condition\":{\"ForAnyValue:StringEquals\":{\"aws:CalledVia\":\"ssm-guiconnect.amazonaws.com\"}},\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:ec2:us-east-1:*:instance/*\",\"arn:aws:ssm:us-east-1:*:managed-instance/*\",\"arn:aws:ssm:us-east-1::document/AWS-StartPortForwardingSession\"]},{\"Action\":[\"ssmmessages:OpenDataChannel\"],\"Condition\":{\"ForAnyValue:StringEquals\":{\"aws:CalledVia\":\"ssm-guiconnect.amazonaws.com\"}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:ssm:us-east-1:*:session/*\"},{\"Action\":[\"ssm:TerminateSession\"],\"Condition\":{\"StringLike\":{\"ssm:resourceTag/aws:ssmmessages:session-id\":[\"${aws:userid}\"]}},\"Effect\":\"Allow\",\"Resource\":\"*\"}],\"Version\":\"2012-10-17\"}",
            "policy_id": "ANPA5TH4YT2AGPPRJTXBW",
            "tags": {
